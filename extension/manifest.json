{
  "manifest_version": 3,
  "name": "TimeBridge",
  "version": "0.1.0",
  "description": "Shows the local time for whoever you're messaging, right where you type.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": [
        "vendor/chrono.bundle.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}