{
  "manifest_version": 3,
  "name": "TimeBridge",
  "version": "1.0.0",
  "description": "See the local time for whoever you're messaging, right where you type.",
  "permissions": ["storage", "activeTab"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "TimeBridge"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["vendor/chrono.bundle.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}